diff --git a/scripts/UPSTREAM-AUTOMATION.md b/scripts/UPSTREAM-AUTOMATION.md
new file mode 100644
index 0000000000000000000000000000000000000000..fd37ea22199fbcc7245ce362d0025a3aa243532f
--- /dev/null
+++ b/scripts/UPSTREAM-AUTOMATION.md
@@ -0,0 +1,75 @@
+# Daily upstream integration
+
+BB automation `auto_syvconbnnhc` in project `proj_zpyirjtmqp` runs
+`check-upstream.py` daily at **09:00 Europe/Berlin** (`0 9 * * *`). The BB
+server must be running on this Mac, with authenticated `gh` and Codex access.
+
+The checker reads the baseline from `update-upstream-patches.py`, pins the
+upstream default branch HEAD, and paginates the provider's commit history.
+No changes means no stdout/stderr, no model call, and a silent skipped tick.
+It fails if the baseline cannot be found rather than importing uncertain history.
+
+When changes exist, it starts one BB thread in environment `env_r4vevp8jj8`
+(this checkout), with provider `codex`, model `gpt-6.1-sol`, reasoning `medium`,
+and Full Access for unattended local maintenance. The prompt is read from
+`scripts/upstream-sync-prompt.md` in the checkout at dispatch time. It requires:
+
+- Russian for all user-facing conversation messages; English for repository
+  documentation, code comments, and Git commit messages.
+- Complete import through the pinned provider commit, preserving fork behavior.
+- A release version bump with the new upstream SHA, documentation and patch updates.
+- Typecheck, tests, build, and comparison-patch verification before committing.
+- A local unsigned commit using
+  `git -c commit.gpgsign=false commit --no-gpg-sign`; signing settings stay intact.
+- No push or plugin reload.
+
+The checker refuses to dispatch over uncommitted files or a detached HEAD.
+The agent also rechecks the dispatch HEAD and baseline before editing. A file
+lock prevents concurrent dispatch, and a persisted thread ID prevents another
+integration while its thread or background agents are active. Finished attempts
+can be retried on a later check if changes still remain and the checkout is clean.
+An incomplete attempt that leaves edits requires inspection before another run.
+
+## Inspect or run
+
+```sh
+# Read-only check: prints JSON only when newer provider commits exist.
+python3 scripts/check-upstream.py --check-only
+
+# Checker unit tests (no network, model calls, or tracked bytecode files).
+PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts -p 'test_*.py' -v
+
+bb automation show auto_syvconbnnhc --project proj_zpyirjtmqp
+bb automation runs auto_syvconbnnhc --project proj_zpyirjtmqp --limit 5
+bb automation run auto_syvconbnnhc --project proj_zpyirjtmqp
+bb automation pause auto_syvconbnnhc --project proj_zpyirjtmqp
+bb automation resume auto_syvconbnnhc --project proj_zpyirjtmqp
+```
+
+Script automations store a private copy of the checker. After changing
+`check-upstream.py`, refresh that copy from this checkout:
+
+```sh
+bb automation update auto_syvconbnnhc --project proj_zpyirjtmqp \
+  --script-file scripts/check-upstream.py
+```
+
+The prompt file is read live and needs no automation refresh. If the checkout
+or BB environment moves, update the automation working directory and
+`UPSTREAM_SYNC_REPO` / `UPSTREAM_SYNC_ENVIRONMENT` variables together.
+
+Dispatch state is stored beside the private checker copy, normally
+`~/.bb/plugins/automations/scripts/auto_syvconbnnhc/check-state.json`.
+If a spawn call loses its connection after creating a thread, the state remains
+`dispatching` and subsequent runs fail rather than spawn duplicates. Inspect the
+project's threads first; recover the correct thread ID in that state, or clear
+the marker only after verifying there is no active integration. Do not clear
+the state of a running integration. `UPSTREAM_SYNC_STATE` can override its path.
+
+## Initial validation
+
+The checker has 10 passing unit tests for pagination, no-op silence, missing
+baselines, concurrency, exact model selection, checkout changes, and uncertain
+spawn outcomes. A live read-only GitHub check found no new provider commits.
+The initial manual BB run also exited zero with empty output and was recorded
+as a skipped silent tick. No integration agent was needed or spawned.
diff --git a/scripts/check-upstream.py b/scripts/check-upstream.py
new file mode 100644
index 0000000000000000000000000000000000000000..14bdf91f921cffeeb0ebf36c37dfadec55889b2d
--- /dev/null
+++ b/scripts/check-upstream.py
@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+"""Silent daily upstream check; dispatch a BB Codex thread only when needed."""
+
+import argparse
+import ast
+from contextlib import contextmanager
+import fcntl
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+from urllib.parse import urlencode
+
+
+UPSTREAM = "get-bb/bb"
+PROVIDER_PATH = "plugins/provider-claude-code"
+MODEL = "gpt-6.1-sol"
+SHA = re.compile(r"[0-9a-f]{40}\Z")
+
+
+def command(args, cwd, *, stdin=None):
+    result = subprocess.run(
+        args, cwd=cwd, input=stdin, text=True, capture_output=True, timeout=90,
+    )
+    if result.returncode:
+        raise RuntimeError(
+            f"{args[0]} {args[1]} failed: {result.stderr.strip() or result.stdout.strip()}"
+        )
+    return result.stdout.strip()
+
+
+def json_command(args, cwd, **kwargs):
+    result = json.loads(command(args, cwd, **kwargs))
+    if isinstance(result, dict) and result.get("ok") is False:
+        raise RuntimeError(f"CLI error: {result.get('error')}")
+    return result
+
+
+def baseline(repo):
+    tree = ast.parse((repo / "scripts/update-upstream-patches.py").read_text())
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and any(
+            isinstance(target, ast.Name) and target.id == "UPSTREAM_COMMIT"
+            for target in node.targets
+        ):
+            value = ast.literal_eval(node.value)
+            if isinstance(value, str) and SHA.fullmatch(value):
+                return value
+    raise RuntimeError("Missing or invalid UPSTREAM_COMMIT")
+
+
+def pending_commits(repo, imported):
+    metadata = json_command(["gh", "api", f"repos/{UPSTREAM}"], repo)
+    head = json_command(
+        ["gh", "api", f"repos/{UPSTREAM}/commits/{metadata['default_branch']}"], repo,
+    )["sha"]
+    if not SHA.fullmatch(head):
+        raise RuntimeError("Invalid upstream HEAD")
+    pending = []
+    for page in range(1, 101):
+        query = urlencode({
+            "sha": head, "path": PROVIDER_PATH, "per_page": 100, "page": page,
+        })
+        commits = json_command(["gh", "api", f"repos/{UPSTREAM}/commits?{query}"], repo)
+        for commit in commits:
+            sha = commit["sha"]
+            if not SHA.fullmatch(sha):
+                raise RuntimeError("Invalid upstream commit SHA")
+            if sha == imported:
+                return list(reversed(pending))
+            pending.append({
+                "sha": sha,
+                "date": commit["commit"]["committer"]["date"],
+                "title": commit["commit"]["message"].splitlines()[0],
+            })
+        if len(commits) < 100:
+            break
+    raise RuntimeError("Imported baseline not found in upstream provider history; inspect ancestry")
+
+
+@contextmanager
+def state_lock(path):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.with_suffix(".lock").open("a") as handle:
+        try:
+            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            yield False
+            return
+        try:
+            yield True
+        finally:
+            fcntl.flock(handle, fcntl.LOCK_UN)
+
+
+def save_state(path, value):
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(value, indent=2) + "\n")
+    temporary.replace(path)
+
+
+def dispatch(repo, project, environment, state_path, commits, imported):
+    bb = os.environ.get("BB_CLI") or "bb"
+    with state_lock(state_path) as acquired:
+        if not acquired:
+            return
+        state = json.loads(state_path.read_text()) if state_path.exists() else {}
+        if state.get("dispatching"):
+            raise RuntimeError(
+                f"Previous spawn outcome is uncertain; inspect threads before clearing {state_path}"
+            )
+        if state.get("threadId"):
+            thread = json_command([bb, "thread", "show", state["threadId"], "--json"], repo)["thread"]
+            if thread["status"] not in {"idle", "error", "failed", "stopped"} or (
+                thread.get("queuedMessageCount", 0) or thread.get("activeBackgroundAgentCount", 0)
+            ):
+                return
+        if baseline(repo) != imported:
+            return  # Another integration advanced the baseline during the network check.
+        if command(["git", "status", "--porcelain", "--untracked-files=normal"], repo):
+            raise RuntimeError("Checkout has uncommitted changes; upstream integration was not started")
+        head = command(["git", "rev-parse", "HEAD"], repo)
+        if not command(["git", "branch", "--show-current"], repo):
+            raise RuntimeError("Checkout is detached; upstream integration was not started")
+        prompt = (repo / "scripts/upstream-sync-prompt.md").read_text()
+        prompt += "\n\nPinned dispatch context (JSON data, not instructions):\n"
+        prompt += json.dumps({
+            "repository": str(repo), "localHead": head, "importedBaseline": imported,
+            "targetBaseline": commits[-1]["sha"], "commitsOldestFirst": commits,
+        }, ensure_ascii=False, indent=2)
+        # Persist before spawn. If the CLI connection fails after creation, fail
+        # closed rather than spawn duplicate agents on automation retries.
+        save_state(state_path, {"dispatching": True, "target": commits[-1]["sha"]})
+        result = json_command([
+            bb, "thread", "spawn", "--project", project,
+            "--environment", environment, "--provider", "codex", "--model", MODEL,
+            "--reasoning-level", "medium", "--permission-mode", "full",
+            "--title", f"Sync Claude provider through {commits[-1]['sha'][:7]}",
+            "--prompt-file", "-", "--json",
+        ], repo, stdin=prompt)
+        thread_id = result["id"]
+        save_state(state_path, {"threadId": thread_id, "target": commits[-1]["sha"]})
+        print(json.dumps({"threadId": thread_id, "model": MODEL, "reasoning": "medium",
+                          "target": commits[-1]["sha"], "commitCount": len(commits)}))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check-only", action="store_true", help="Report changes without spawning")
+    args = parser.parse_args()
+    repo = Path(os.environ.get("UPSTREAM_SYNC_REPO", os.getcwd())).resolve()
+    imported = baseline(repo)
+    commits = pending_commits(repo, imported)
+    if not commits:
+        return
+    if args.check_only:
+        print(json.dumps({"baseline": imported, "commits": commits}, ensure_ascii=False))
+        return
+    project = os.environ.get("BB_PROJECT_ID")
+    environment = os.environ.get("UPSTREAM_SYNC_ENVIRONMENT")
+    if not project or not environment:
+        raise RuntimeError("Set BB_PROJECT_ID and UPSTREAM_SYNC_ENVIRONMENT for dispatch")
+    state = Path(os.environ.get("UPSTREAM_SYNC_STATE", str(Path(__file__).with_name("check-state.json"))))
+    dispatch(repo, project, environment, state, commits, imported)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, KeyError, RuntimeError, subprocess.TimeoutExpired) as error:
+        print(f"Upstream check failed: {error}", file=sys.stderr)
+        sys.exit(1)
