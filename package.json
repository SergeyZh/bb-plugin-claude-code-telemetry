{
  "name": "bb-plugin-claude-code-telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run bb threads with Claude Code.",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104",
    "node": ">=22"
  },
  "bb": {
    "name": "Claude Code Telemetry [Experimental]",
    "description": "Run Claude Code alongside the built-in provider with usage telemetry for each model request.",
    "branding": {
      "icon": "./icons/claude-code.svg"
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "claude-code-telemetry",
        "displayName": "Claude Code Telemetry"
      }
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "@get-bb/plugin-sdk": "0.6.104",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
